{
    "manifest_version": 2,
    "name": "hacker news terminal theme",
    "version": "1.0",

    "description": "cool terminal hacker theme for hacker news",

    "icons": {
        "48": "icon48.png"
    },

    "browser_action": {
        "default_title": "hacker news terminal theme",
        "default_icon": {
            "16": "icon16.png"
        }
    },

    "content_scripts": [
        {
            "matches": ["https://news.ycombinator.com/*"],
			"css": ["styles.css"]
        }
    ]
}
